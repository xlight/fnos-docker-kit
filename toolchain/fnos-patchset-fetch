#!/usr/bin/env python3
# 从公开仓下载当前运行版本缺失的补丁集：读索引 → 下载 → sha256 → 结构校验 → 原子安装。
# 失败一律 exit 0（开机不被阻塞），原因写 stderr/journal。
import hashlib, json, os, re, ssl, sys, tempfile, urllib.request

D = "/usr/local/share/fnos-toolchain"
PATCHES = D + "/patches"
VER_PATH = "/usr/trim/etc/version"
INDEX_URL = os.environ.get(
    "FNOS_INDEX_URL",
    "https://raw.githubusercontent.com/xlight/fnos-docker-kit/main/toolchain/patches/index.json")


def log(msg):
    print("patchset-fetch:", msg, file=sys.stderr, flush=True)


def fetch(url, timeout=20):
    req = urllib.request.Request(url, headers={"Accept-Encoding": "identity",
                                                "User-Agent": "fnos-patchset-fetch/1.0"})
    with urllib.request.urlopen(req, timeout=timeout, context=ssl.create_default_context()) as r:
        return r.read()


def main():
    try:
        rv = open(VER_PATH).read().strip().lstrip("Vv")
    except OSError:
        log("cannot read %s" % VER_PATH)
        return 0
    if not rv:
        log("empty version")
        return 0
    if os.path.exists(os.path.join(PATCHES, "fnos-%s.json" % rv)):
        log("patchset for %s already present" % rv)
        return 0
    try:
        idx = json.loads(fetch(INDEX_URL).decode("utf-8"))
    except Exception as e:
        log("index fetch failed: %s" % e)
        return 0
    e = (idx.get("versions") or {}).get(rv)
    if not e:
        log("no index entry for %s (readiness missing)" % rv)
        return 0
    name = e.get("patchset")
    want_sha = e.get("sha256")
    base = INDEX_URL.rsplit("/", 1)[0]
    try:
        raw = fetch("%s/%s" % (base, name))
    except Exception as ex:
        log("patchset download failed: %s" % ex)
        return 0
    if hashlib.sha256(raw).hexdigest() != want_sha:
        log("sha256 mismatch for %s, discarded" % name)
        return 0
    try:
        ps = json.loads(raw)
    except Exception:
        log("downloaded patchset is not JSON, discarded")
        return 0
    # 结构校验：版本匹配、patches 非空、id 唯一、file_hashes 存在（不做二进制预验证——目标二进制尚未安装）
    ids = [p.get("id") for p in ps.get("patches") or []]
    if (str(ps.get("fnos_version", "")).lstrip("Vv") != rv or not ids
            or len(ids) != len(set(ids)) or not ps.get("file_hashes")):
        log("structural validation failed for %s, discarded" % name)
        return 0
    dst = os.path.join(PATCHES, name)
    fd, tmp = tempfile.mkstemp(dir=PATCHES, prefix=".fetch-")
    with os.fdopen(fd, "wb") as f:
        f.write(raw)
        f.flush()
        os.fsync(f.fileno())
    os.replace(tmp, dst)
    dfd = os.open(PATCHES, os.O_RDONLY)
    try:
        os.fsync(dfd)
    finally:
        os.close(dfd)
    log("installed %s (sha256 ok, %d patches)" % (name, len(ids)))
    return 0


if __name__ == "__main__":
    sys.exit(main())
